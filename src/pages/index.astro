---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Interlude from '../components/Interlude.astro';
import Work from '../components/Work.astro';
import Projects from '../components/Projects.astro';
import OpenSource from '../components/OpenSource.astro';
import Approach from '../components/Approach.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Stack from '../components/Stack.astro';
import ClientSites from '../components/ClientSites.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Companion from '../components/Companion.astro';
import { profile } from '../data/site';
---

<Base
  title={`${profile.name} — ${profile.role}`}
  description={profile.metaDescription}
>
  <Header />

  {/*
    Four acts, with a beat between each:

      who        → hero
      the proof  → work, side projects
      the person → about, experience, stack
      the ask    → client builds, contact

    The interludes exist to break the rhythm. Seven identical list sections in
    a row is what made the page read as a spec sheet.
  */}
  <main>
    <Hero />

    <Interlude
      line="Correct under load beats clever."
      footnote="Data migrations that don't lose rows. Pipelines that resume where they failed. Interfaces that stay fast at a hundred thousand records."
    />

    <Work />
    <Projects />
    <OpenSource />

    <Approach />

    <About />
    <Experience />
    <Stack />

    <ClientSites />
    <Contact />
  </main>

  <Footer />

  <Companion />
</Base>
