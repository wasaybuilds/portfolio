---
import { Font } from 'astro:assets';
import { profile } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Social card, relative to the site root. */
  image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;

/*
 * Absolute URLs, because Open Graph and Twitter both reject relative ones —
 * a relative og:image is the single most common reason a link preview shows
 * no picture. Astro.site comes from astro.config.mjs.
 */
const site = Astro.site ?? new URL('https://wasay-one.vercel.app');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);

/*
 * Person schema. This is what lets a search engine understand that the page is
 * about a person with a job title, an employer and a set of skills, rather
 * than guessing from the prose. It is also what feeds a knowledge panel.
 */
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.shortName,
  url: canonical.href,
  image: ogImage.href,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  description: profile.metaDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lahore',
    addressRegion: 'Punjab',
    addressCountry: 'PK',
  },
  worksFor: { '@type': 'Organization', name: 'Hatzs Dimensions' },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Lahore Garrison University',
  },
  knowsAbout: [
    'TypeScript', 'Node.js', 'React', 'Next.js', 'PostgreSQL',
    'AWS Lambda', 'AWS Step Functions', 'Docker', 'REST API design',
    'Event-driven architecture', 'Data migration',
  ],
  sameAs: [profile.github, profile.linkedin],
};

const themeScript = `(function(){try{var s=localStorage.getItem("theme");var t=s||(window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");document.documentElement.setAttribute("data-theme",t);}catch(e){}document.documentElement.classList.add("js");})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />

    <!-- Matches the browser chrome to the page in each theme. -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#faf9f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#131315" />

    <!-- Open Graph: LinkedIn, WhatsApp, Slack, Facebook, iMessage. -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Abdul" />
    <meta property="profile:last_name" content="Wasay" />

    <!-- Twitter / X. summary_large_image is what gives the full-width card. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${profile.name} — ${profile.role}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    <script is:inline set:html={themeScript} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>

  <body>
    <div class="page-grid" aria-hidden="true">
      <div>
        <span></span><span></span><span></span><span></span>
        <span class="hidden sm:block"></span>
        <span class="hidden sm:block"></span>
        <span class="hidden sm:block"></span>
        <span class="hidden sm:block"></span>
      </div>
    </div>

    <slot />

    <script>
      /* Reveal on entry, once. Elements are visible by default; the `.js`
         class on <html> is what opts them into the hidden start state, so a
         failure here can never leave the page blank. */
      const targets = document.querySelectorAll('[data-reveal]');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        targets.forEach((target) => observer.observe(target));
      } else {
        targets.forEach((target) => target.classList.add('is-visible'));
      }

      /* Theme toggle */
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try {
          localStorage.setItem('theme', next);
        } catch {
          /* Private mode — the toggle still works for this page view. */
        }
      });
    </script>
  </body>
</html>
