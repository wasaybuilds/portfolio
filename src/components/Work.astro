---
import Section from './Section.astro';
import { work } from '../data/site';
---

<Section id="work" label="Work" title="Platforms running in production.">
  <ul class="divide-y divide-rule">
    {work.map((project, i) => (
      <li class="row py-12 first:pt-0 last:pb-0" data-reveal>
        <p class="ordinal mb-4">{String(i + 1).padStart(2, '0')}</p>

        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="text-title">{project.name}</h3>
          <a
            href={project.url}
            target="_blank"
            rel="noopener noreferrer"
            class="link font-mono text-sm"
          >
            {project.urlLabel} ↗
          </a>
        </div>

        <p class="text-lede mt-3 max-w-lg text-ink-soft">{project.blurb}</p>

        <p class="mt-4 max-w-2xl text-sm text-ink-muted">{project.summary}</p>

        {project.problem && (
          <p class="mt-4 max-w-2xl text-sm text-ink-muted">
            <span class="label mr-2">Problem</span>
            {project.problem}
          </p>
        )}

        {project.built && (
          <p class="mt-3 max-w-2xl text-sm text-ink-muted">
            <span class="label mr-2">Built</span>
            {project.built}
          </p>
        )}

        <p class="mt-5 font-mono text-xs text-ink-faint">
          {project.stack.join(' · ')}
          {project.scale && <span class="text-ink-muted"> — {project.scale}</span>}
        </p>
      </li>
    ))}
  </ul>
</Section>
