---
import Section from './Section.astro';
import Diagram from './Diagram.astro';
import MigrationDiagram from './MigrationDiagram.astro';
import { work } from '../data/site';
---

<Section id="work" label="Work" title="Systems running in production.">
  <ul class="divide-y divide-rule">
    {work.map((project) => (
      <li class="row py-12 first:pt-0 last:pb-0" data-reveal>
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <h3 class="text-title">{project.name}</h3>
          {project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="link font-mono text-sm"
            >
              {project.urlLabel} ↗
            </a>
          )}
        </div>

        <p class="text-lede mt-3 max-w-lg text-ink-soft">{project.blurb}</p>

        {/*
          The figures come before any prose. They are the part a reader
          actually stops on, and they are the part that is hardest to fake.
        */}
        {project.scale && (
          <dl class="mt-7 flex flex-wrap gap-x-12 gap-y-5">
            {project.scale.map((figure) => (
              <div>
                <dt class="font-mono text-2xl text-ink sm:text-3xl">
                  {figure.value}
                </dt>
                <dd class="mt-1 text-xs text-ink-muted">{figure.label}</dd>
              </div>
            ))}
          </dl>
        )}

        {/* The architecture, drawn. The lead project has its own diagram
            because its whole point — resuming from a checkpoint — is an arrow
            that goes backwards, which a row of boxes cannot show. */}
        {project.diagram === 'migration' && <MigrationDiagram />}
        {project.stages && <Diagram stages={project.stages} />}

        {/* Problem and built, one sentence each, side by side rather than
            stacked as paragraphs. */}
        {(project.problem || project.built) && (
          <div class="mt-6 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2 sm:gap-10">
            {project.problem && (
              <div>
                <p class="label label--rail">Problem</p>
                <p class="mt-2 text-sm text-ink-soft">{project.problem}</p>
              </div>
            )}
            {project.built && (
              <div>
                <p class="label label--rail">Built</p>
                <p class="mt-2 text-sm text-ink-soft">{project.built}</p>
              </div>
            )}
          </div>
        )}

        <p class="mt-6 font-mono text-xs text-ink-faint">
          {project.role} · {project.stack.join(' · ')}
        </p>
      </li>
    ))}
  </ul>
</Section>
