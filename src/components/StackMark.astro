---
/**
 * Hero mark — four extruded isometric slabs.
 *
 * A visual restatement of the one claim the hero makes: work across the whole
 * stack, interface down to infrastructure.
 *
 * The previous version drew four flat rhombus outlines, which read as four
 * separate shapes rather than a stack — an outline has no thickness, so there
 * was nothing to say one layer sat on top of another. Each slab now has a top
 * face and two side faces, and the top faces are filled with the page colour
 * so a slab genuinely occludes the one behind it. That occlusion is what makes
 * it read as depth rather than as a pattern.
 *
 * Drawn back-to-front, since in this projection the lower slab is the nearer
 * one and has to paint over its neighbour.
 *
 * Purely presentational: aria-hidden, carrying no text a reader needs.
 */

/* Isometric geometry. HALF_H is half the rhombus height; DEPTH is how far the
   side faces drop. PITCH exceeds HALF_H * 2 + DEPTH so slabs never collide. */
const HALF_W = 88;
const HALF_H = 27;
const DEPTH = 10;
const PITCH = 66;
const CENTRES = [40, 40 + PITCH, 40 + PITCH * 2, 40 + PITCH * 3];
const ACCENT = 2;

const CX = 100;

/** Top face: the rhombus itself. */
const top = (cy: number) =>
  `M${CX} ${cy - HALF_H}L${CX + HALF_W} ${cy}L${CX} ${cy + HALF_H}L${CX - HALF_W} ${cy}Z`;

/** Left side face, dropping from the lower-left edge. */
const left = (cy: number) =>
  `M${CX - HALF_W} ${cy}L${CX} ${cy + HALF_H}L${CX} ${cy + HALF_H + DEPTH}L${CX - HALF_W} ${cy + DEPTH}Z`;

/** Right side face, dropping from the lower-right edge. */
const right = (cy: number) =>
  `M${CX + HALF_W} ${cy}L${CX} ${cy + HALF_H}L${CX} ${cy + HALF_H + DEPTH}L${CX + HALF_W} ${cy + DEPTH}Z`;
---

<svg
  viewBox="0 0 200 300"
  fill="none"
  aria-hidden="true"
  class="h-auto w-full max-w-[clamp(9rem,18vw,15rem)]"
>
  <!-- Guides through the outer vertices, implying the column the slabs sit in. -->
  <g class="guide">
    <line x1={CX - HALF_W} y1={CENTRES[0]} x2={CX - HALF_W} y2={CENTRES[3] + DEPTH} />
    <line x1={CX + HALF_W} y1={CENTRES[0]} x2={CX + HALF_W} y2={CENTRES[3] + DEPTH} />
  </g>

  {CENTRES.map((cy, i) => (
    <g class={i === ACCENT ? 'slab slab--accent' : 'slab'}>
      <path class="face face--side" d={left(cy)} />
      <path class="face face--side" d={right(cy)} />
      <path class="face face--top" d={top(cy)} />
    </g>
  ))}

  <!-- A dashed spine through the centre, so the four read as one system. -->
  <line
    class="spine"
    x1={CX}
    y1={CENTRES[0] - HALF_H}
    x2={CX}
    y2={CENTRES[3] + HALF_H + DEPTH}
  />
</svg>

<style>
  .guide line {
    stroke: var(--rule-strong);
    stroke-width: 1;
    opacity: 0.4;
  }

  .face {
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* The top face is filled with the page colour, which is what lets a slab
     occlude the one behind it and turns four shapes into a stack. */
  .face--top {
    fill: var(--paper);
  }

  /* Sides sit slightly darker so the light reads as coming from above. */
  .face--side {
    fill: var(--paper-sunk);
  }

  .slab--accent .face {
    stroke: var(--accent);
    stroke-width: 1.4;
  }

  .slab--accent .face--top {
    fill: var(--accent-wash);
  }

  .spine {
    stroke: var(--rule-strong);
    stroke-width: 1;
    stroke-dasharray: 2 5;
    opacity: 0.45;
  }
</style>
