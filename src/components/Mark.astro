---
/**
 * Small hairline glyphs for the Approach cards, in the same stroke weight as
 * the pipeline diagrams so they belong to the same drawing language.
 * Each states the idea of its card: a plan, a pulse, a root, lines of text.
 */
interface Props {
  name: 'plan' | 'pulse' | 'root' | 'read';
}

const { name } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="hidden h-10 w-10 shrink-0 text-accent sm:block"
>
  {name === 'plan' && (
    <>
      <rect x="4" y="6" width="32" height="28" rx="2" />
      <path d="M4 14h32" />
      <path d="M14 14v20" />
      <path d="M19 20h12M19 25h8" stroke-dasharray="2 3" />
    </>
  )}

  {name === 'pulse' && (
    <>
      <path d="M4 20h7l4-9 5 18 4-11 3 6h9" />
      <circle cx="32" cy="24" r="1.6" fill="currentColor" stroke="none" />
    </>
  )}

  {name === 'root' && (
    <>
      <path d="M20 5v13" />
      <path d="M20 18c0 6-6 7-6 12" />
      <path d="M20 18c0 6 6 7 6 12" />
      <path d="M20 18v16" />
      <circle cx="20" cy="5" r="2.2" />
    </>
  )}

  {name === 'read' && (
    <>
      <path d="M6 9h20M6 15h26M6 21h16M6 27h22" />
      <path d="M30 27l3 3 5-7" stroke-width="1.6" />
    </>
  )}
</svg>
