---
/**
 * The Salesforce → DealerIQ pipeline, drawn.
 *
 * This is the strongest thing on the site and it was rendering as three
 * unlabelled boxes. The point of the architecture is the checkpoint store: a
 * failed multi-gigabyte run resumes from the last good checkpoint instead of
 * restarting. A left-to-right row of boxes cannot show that, because the whole
 * idea is the arrow that goes *backwards*.
 *
 * So the checkpoint store sits below the row with a resume path looping back
 * into stage one, and Step Functions brackets the stages it orchestrates.
 * Every label is a real component or a figure from ABOUT.md — nothing here is
 * decorative.
 *
 * Static: no state, no script. It scrolls horizontally on narrow screens
 * rather than shrinking its labels below legibility.
 */
---

<figure class="migration">
  <div class="migration__scroll">
    <svg viewBox="0 0 524 246" fill="none" role="img" class="migration__svg"
      aria-label="Pipeline: Salesforce, then extract and join with checkpointing, then transform to a composite schema, then authenticated webhook load into DealerIQ. Step Functions orchestrates the three stages; a checkpoint store on S3 allows a failed run to resume from the last checkpoint.">

      <!-- ── Step Functions bracket over the stages it orchestrates ── -->
      <g class="orch">
        <path d="M92 44v-10h344v10" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" opacity="0.45" />
        <rect x="196" y="20" width="136" height="19" rx="9.5" fill="var(--paper)" />
        <text x="264" y="33" class="t t--mono">AWS Step Functions</text>
      </g>

      <!-- ── Source ── -->
      <g class="node">
        <rect x="4" y="82" width="66" height="52" rx="6" stroke="currentColor" stroke-width="1.5" />
        <text x="37" y="104" class="t t--node">Salesforce</text>
        <text x="37" y="118" class="t t--sub">source</text>
      </g>

      <!-- ── Stage 1 ── -->
      <g class="node">
        <rect x="92" y="70" width="112" height="76" rx="8" stroke="currentColor" stroke-width="1.6" />
        <text x="148" y="92" class="t t--step">01</text>
        <text x="148" y="110" class="t t--node">Extract + join</text>
        <text x="148" y="126" class="t t--sub">checkpointed</text>
      </g>

      <!-- ── Stage 2 ── -->
      <g class="node">
        <rect x="224" y="70" width="112" height="76" rx="8" stroke="currentColor" stroke-width="1.6" />
        <text x="280" y="92" class="t t--step">02</text>
        <text x="280" y="110" class="t t--node">Transform</text>
        <text x="280" y="126" class="t t--sub">composite schema</text>
      </g>

      <!-- ── Stage 3 ── -->
      <g class="node">
        <rect x="356" y="70" width="112" height="76" rx="8" stroke="currentColor" stroke-width="1.6" />
        <text x="412" y="92" class="t t--step">03</text>
        <text x="412" y="110" class="t t--node">Load</text>
        <text x="412" y="126" class="t t--sub">signed webhook</text>
      </g>

      <!-- ── Target ── -->
      <g class="node">
        <rect x="490" y="82" width="30" height="52" rx="6" stroke="currentColor" stroke-width="1.5" />
        <text x="505" y="112" class="t t--node">IQ</text>
      </g>

      <!-- ── Forward path ── -->
      <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M70 108h16" />
        <path d="M81 103.5 86 108l-5 4.5" />
        <path d="M204 108h14" />
        <path d="M213 103.5 218 108l-5 4.5" />
        <path d="M336 108h14" />
        <path d="M345 103.5 350 108l-5 4.5" />
        <path d="M468 108h16" />
        <path d="M479 103.5 484 108l-5 4.5" />
      </g>

      <!-- ── Volume annotations, on the edges they describe ── -->
      <text x="148" y="60" class="t t--figure">350k+ records</text>
      <text x="280" y="60" class="t t--figure">500+ field mappings</text>

      <!-- ── Checkpoint store and the resume path ── -->
      <g class="ckpt">
        <path d="M148 146v28" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6" />

        <rect x="80" y="174" width="136" height="40" rx="6" stroke="var(--accent)" stroke-width="1.4" />
        <text x="148" y="190" class="t t--node t--accent">S3 checkpoint store</text>
        <text x="148" y="204" class="t t--sub">last good offset</text>

        <!-- The backwards arrow: the reason the architecture exists. -->
        <path
          d="M80 194H44a8 8 0 0 1-8-8v-70a8 8 0 0 1 8-8h42"
          stroke="var(--accent)"
          stroke-width="1.4"
          stroke-dasharray="4 4"
          fill="none"
        />
        <path d="M81 103.5 86 108l-5 4.5" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        <text x="36" y="232" class="t t--figure t--accent" text-anchor="start">resume from last checkpoint</text>
      </g>

      <!-- ── Regression suite, attached to the load stage ── -->
      <g class="ckpt">
        <path d="M412 146v28" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 3" opacity="0.6" />
        <rect x="344" y="174" width="136" height="40" rx="6" stroke="currentColor" stroke-width="1.3" />
        <text x="412" y="190" class="t t--node">Regression suite</text>
        <text x="412" y="204" class="t t--sub">850 records · 44s</text>
      </g>
    </svg>
  </div>

  <figcaption class="migration__caption">
    Three decoupled stages. A failed run resumes from the last checkpoint
    rather than restarting a multi-gigabyte job.
  </figcaption>
</figure>

<style>
  .migration {
    margin-top: 1.75rem;
  }

  /* Wide diagrams scroll in their own container rather than shrinking labels
     below legibility or forcing the page to scroll sideways. */
  .migration__scroll {
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .migration__svg {
    min-width: 32rem;
    width: 100%;
    height: auto;
    color: var(--ink-soft);
  }

  .migration__caption {
    margin-top: 0.875rem;
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--ink-faint);
    max-width: 34rem;
  }

  /* Type inside the drawing, in tokens so it inverts with the theme. */
  .t {
    font-family: var(--font-mono), ui-monospace, monospace;
    text-anchor: middle;
  }
  .t--node {
    font-size: 10px;
    fill: var(--ink);
  }
  .t--sub {
    font-size: 8px;
    fill: var(--ink-faint);
    letter-spacing: 0.04em;
  }
  .t--step {
    font-size: 8px;
    fill: var(--ink-faint);
    letter-spacing: 0.14em;
  }
  .t--mono {
    font-size: 9px;
    fill: var(--ink-muted);
    letter-spacing: 0.08em;
  }
  .t--figure {
    font-size: 8.5px;
    fill: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .t--accent {
    fill: var(--accent);
  }
</style>
