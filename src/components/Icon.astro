---
/**
 * Inline icon set. Kept as paths in one component rather than pulled from a
 * library, because four icons do not justify a dependency and inlining means
 * they cost nothing at runtime and inherit currentColor for free.
 */
interface Props {
  name: 'email' | 'github' | 'linkedin' | 'document' | 'arrow';
  class?: string;
}

const { name, class: className = 'h-3.5 w-3.5' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  {name === 'email' && (
    <>
      <rect x="2.5" y="4.5" width="19" height="15" rx="2" />
      <path d="m3 6 9 6.5L21 6" />
    </>
  )}

  {name === 'github' && (
    <path
      d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"
      fill="none"
    />
  )}

  {name === 'linkedin' && (
    <>
      <rect x="2.5" y="2.5" width="19" height="19" rx="2" />
      <path d="M7 10.5V17" />
      <circle cx="7" cy="7.2" r="0.9" fill="currentColor" stroke="none" />
      <path d="M11 17v-3.6a2.4 2.4 0 0 1 4.8 0V17" />
      <path d="M11 10.5V17" />
    </>
  )}

  {name === 'document' && (
    <>
      <path d="M14 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7.5Z" />
      <path d="M14 2.5v5h5" />
      <path d="M12 11v6" />
      <path d="m9.5 14.5 2.5 2.5 2.5-2.5" />
    </>
  )}

  {name === 'arrow' && <path d="M7 17 17 7M8 7h9v9" />}
</svg>
