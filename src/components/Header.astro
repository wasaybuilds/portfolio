---
import { profile, sections } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/85 backdrop-blur-md">
  <div class="shell flex h-14 items-center justify-between gap-6">
    <a href="#top" class="font-mono text-sm text-ink no-underline">
      {profile.shortName}<span class="text-accent">.</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {sections.map((section) => (
        <a
          href={`#${section.id}`}
          class="text-sm text-ink-muted no-underline transition-colors hover:text-ink"
        >
          {section.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={profile.resumeUrl}
        download
        class="rounded-full border border-rule px-3.5 py-1.5 font-mono text-xs text-ink-muted no-underline transition-colors hover:border-rule-strong hover:text-ink"
      >
        CV
      </a>
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle colour theme"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-rule text-ink-muted transition-colors hover:border-rule-strong hover:text-ink"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </button>
    </div>
  </div>
</header>
