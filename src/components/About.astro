---
import Section from './Section.astro';
import { about, education, profile } from '../data/site';
---

<Section id="about" label="About" title="How I work.">
  <div class="max-w-2xl space-y-6">
    {about.map((paragraph) => (
      <p class="text-ink-soft" data-reveal>{paragraph}</p>
    ))}
  </div>

  <dl class="mt-10 grid gap-x-10 gap-y-6 border-t border-rule pt-8 sm:grid-cols-2" data-reveal>
    <div>
      <dt class="label label--rail">Based in</dt>
      <dd class="mt-2 text-ink">{profile.location}</dd>
      <dd class="mt-1 text-sm text-ink-muted">US, UK, EU and Gulf teams.</dd>
    </div>

    <div>
      <dt class="label label--rail">Education</dt>
      <dd class="mt-2 text-ink">{education.school}</dd>
      <dd class="mt-1 text-sm text-ink-muted">
        {education.degree} · {education.period}
      </dd>
    </div>
  </dl>
</Section>
