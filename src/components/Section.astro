---
/**
 * Section chrome, deliberately thin.
 *
 * A hairline, a sticky mono label, and the content column. The numbered
 * "chapter" treatment this replaced was decoration: it implied a narrative the
 * page does not actually have, and it is the single most common tell of a
 * template. The label alone does the orientation job.
 */
interface Props {
  id: string;
  label: string;
  /** Large section heading. Omit for sections that read as a continuation. */
  title?: string;
}

const { id, label, title } = Astro.props;
---

<section id={id} class="section-pad border-t border-rule">
  <div class="shell">
    <div class="rail">
      <p class="label label--ticked label--rail lg:sticky lg:top-24 lg:self-start">{label}</p>
      <div class="min-w-0">
        {title && (
          <h2 class="text-section mb-10 max-w-2xl sm:mb-14" data-reveal>
            {title}
          </h2>
        )}
        <slot />
      </div>
    </div>
  </div>
</section>
