---
import Section from './Section.astro';
import SystemStory from './SystemStory.astro';
import { about, education, principles, profile } from '../data/site';
---

<Section id="approach" label="Approach" title="How I work.">
  <p class="text-lede mb-14 max-w-xl text-ink-soft sm:mb-20" data-reveal>
    {about[0]}
  </p>

  {/*
    Sticky graphic, stepper text — the pattern behind most scrollytelling that
    actually works.

    An earlier version pinned everything and crossfaded the text, which meant
    nothing appeared to move and the scroll drove nothing. Here the text scrolls
    normally, which is what gives the reader a sense of travel, and only the
    diagram is pinned. It changes state as each step arrives.

    The binding matters more than the mechanism: the scrollbar maps onto the
    life of a service — drawn, running, broken, handed over. Scroll bound to
    nothing is just a slow page.
  */}
  <div id="approach-steps" class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:gap-16">
    <!-- The graphic. Pinned on wide screens, inline above the text on narrow. -->
    <div class="lg:sticky lg:top-28 lg:h-[62vh] lg:self-start">
      <div class="flex h-full items-center rounded-xl border border-rule p-6">
        <SystemStory />
      </div>
    </div>

    <!-- The steps. Ordinary flow, generously spaced so each gets its moment. -->
    <ol class="space-y-[22vh] lg:space-y-[38vh] lg:pb-[18vh] lg:pt-[12vh]">
      {principles.map((principle, i) => (
        <li class="step" data-step={i}>
          <div class="flex items-center gap-4">
            <span class="font-mono text-xs text-ink-faint">
              {String(i + 1).padStart(2, '0')} / {String(principles.length).padStart(2, '0')}
            </span>
            <span class="h-px flex-1 bg-rule"></span>
            <p class="label label--rail">{principle.phase}</p>
          </div>

          <h3 class="text-section mt-5">{principle.title}</h3>
          <p class="text-lede mt-4 max-w-md text-ink-soft">{principle.body}</p>
          <p class="mt-6 flex gap-3 border-t border-rule pt-4 text-sm text-ink-muted">
            <span class="text-accent" aria-hidden="true">→</span>
            {principle.proof}
          </p>
        </li>
      ))}
    </ol>
  </div>

  <div class="mt-16 border-t border-rule pt-8 sm:mt-24" data-reveal>
    <p class="text-lede max-w-xl text-ink">{about[1]}</p>

    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      <div>
        <dt class="label label--rail">Based in</dt>
        <dd class="mt-2 text-ink">{profile.location}</dd>
        <dd class="mt-1 text-sm text-ink-muted">US, UK, EU and Gulf teams.</dd>
      </div>

      <div>
        <dt class="label label--rail">Education</dt>
        <dd class="mt-2 text-ink">{education.school}</dd>
        <dd class="mt-1 text-sm text-ink-muted">
          {education.degree} · {education.period}
        </dd>
      </div>
    </dl>
  </div>
</Section>

<style>
  /* Steps dim until they are the one being told, so the eye knows where it is.
     Full opacity by default: without JS every step reads normally. */
  .step {
    transition: opacity 0.5s ease;
  }

  @media (min-width: 64rem) {
    :global(.js) .step {
      opacity: 0.32;
    }
    :global(.js) .step.is-current {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .step {
      opacity: 1;
    }
  }
</style>

<script>
  const root = document.getElementById('approach-steps');
  const story = root?.querySelector<HTMLElement>('.system-story');

  if (root && story) {
    const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));

    /* The step nearest the middle of the viewport is the one being told.
       Reading position, not entry order — scrolling back up works too. */
    const observer = new IntersectionObserver(
      () => {
        const middle = window.innerHeight / 2;
        let best = 0;
        let bestDistance = Infinity;

        steps.forEach((step, i) => {
          const box = step.getBoundingClientRect();
          const distance = Math.abs(box.top + box.height / 2 - middle);
          if (distance < bestDistance) {
            bestDistance = distance;
            best = i;
          }
        });

        story.dataset.state = String(best);
        steps.forEach((step, i) => step.classList.toggle('is-current', i === best));
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 },
    );

    steps.forEach((step) => observer.observe(step));
  }
</script>
