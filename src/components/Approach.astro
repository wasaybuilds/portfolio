---
import Section from './Section.astro';
import Mark from './Mark.astro';
import { about, education, principles, profile } from '../data/site';
---

<Section id="approach" label="Approach" title="How I work.">
  {/* The thesis, before the story that argues for it. */}
  <p class="text-lede mb-12 max-w-xl text-ink-soft sm:mb-16" data-reveal>
    {about[0]}
  </p>

  {/*
    Scrollytelling, not a card stack.

    The previous version pinned each card 3rem below the last so they piled up
    — which reads as boxes accumulating, not as a story being told. Here the
    panel holds the viewport and the story advances *through* it: one beat at a
    time, each crossfading into the next, with a progress rail showing how far
    in you are.

    The track is four screens tall; the panel inside is sticky. Scroll position
    within the track drives which beat is shown and how far it has moved, so
    the animation is tied to the reader's scrolling rather than to a timer.

    Progressive enhancement, deliberately in this direction: the markup below
    is a plain readable list of all four beats. The script adds `is-scrolly`
    only on a wide viewport with motion allowed, and only that class turns it
    into a pinned panel. Without JS, on a phone, or with reduce-motion, the
    reader gets the whole story as ordinary stacked text.
  */}
  <div id="approach-track" class="approach-track">
    <div class="approach-panel">
      <!-- Progress rail -->
      <ol class="approach-rail" aria-hidden="true">
        {principles.map((principle, i) => (
          <li class="approach-rail__item" data-rail={i}>
            <span class="approach-rail__bar"></span>
            <span class="approach-rail__label">{principle.phase}</span>
          </li>
        ))}
      </ol>

      <div class="approach-beats">
        {principles.map((principle, i) => (
          <article class="approach-beat" data-beat={i}>
            <div class="flex items-center gap-4">
              <span class="font-mono text-xs text-ink-faint">
                {String(i + 1).padStart(2, '0')} / {String(principles.length).padStart(2, '0')}
              </span>
              <span class="h-px flex-1 bg-rule"></span>
              <p class="label label--rail">{principle.phase}</p>
            </div>

            <div class="mt-6 flex items-start gap-5">
              <Mark name={principle.mark} />

              <div class="min-w-0">
                <h3 class="text-section">{principle.title}</h3>
                <p class="mt-4 max-w-lg text-lede text-ink-soft">
                  {principle.body}
                </p>
                <p class="mt-6 flex gap-3 border-t border-rule pt-4 text-sm text-ink-muted">
                  <span class="text-accent" aria-hidden="true">→</span>
                  {principle.proof}
                </p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>

  {/*
    The close. After four beats about how systems should be built, the personal
    line lands better than it did opening a separate About section — it is the
    answer to "and who is saying all this".
  */}
  <div class="mt-14 border-t border-rule pt-8 sm:mt-20" data-reveal>
    <p class="text-lede max-w-xl text-ink">{about[1]}</p>

    <dl class="mt-8 grid gap-x-10 gap-y-6 sm:grid-cols-2">
      <div>
        <dt class="label label--rail">Based in</dt>
        <dd class="mt-2 text-ink">{profile.location}</dd>
        <dd class="mt-1 text-sm text-ink-muted">US, UK, EU and Gulf teams.</dd>
      </div>

      <div>
        <dt class="label label--rail">Education</dt>
        <dd class="mt-2 text-ink">{education.school}</dd>
        <dd class="mt-1 text-sm text-ink-muted">
          {education.degree} · {education.period}
        </dd>
      </div>
    </dl>
  </div>
</Section>

<style>
  /* ---- Base: a plain, fully readable list. This is what ships without JS. -- */
  .approach-beats {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .approach-rail {
    display: none;
  }

  /* ---- Enhanced: pinned panel, one beat at a time. --------------------- */
  .approach-track.is-scrolly {
    position: relative;
    /* One screen of scroll per beat, set by script from the beat count. */
    height: var(--track-height);
  }

  .is-scrolly .approach-panel {
    position: sticky;
    top: 7rem;
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 2.5rem;
    align-items: center;
    min-height: 24rem;
  }

  .is-scrolly .approach-beats {
    position: relative;
    display: block;
    min-height: 22rem;
  }

  .is-scrolly .approach-beat {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: translateY(1.75rem);
    transition:
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }

  .is-scrolly .approach-beat.is-active {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* A beat already read leaves upward, so the sequence has a direction. */
  .is-scrolly .approach-beat.is-past {
    opacity: 0;
    transform: translateY(-1.75rem);
  }

  /* ---- Progress rail --------------------------------------------------- */
  .is-scrolly .approach-rail {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    align-self: center;
  }

  .approach-rail__item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .approach-rail__bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--rule);
    border-radius: 999px;
    overflow: hidden;
    position: relative;
  }

  .approach-rail__bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
    transition: transform 0.25s linear;
  }

  .approach-rail__label {
    font-family: var(--font-mono), ui-monospace, monospace;
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    transition: color 0.3s ease;
  }

  .approach-rail__item.is-active .approach-rail__label {
    color: var(--ink);
  }
</style>

<script>
  const track = document.getElementById('approach-track');

  if (track) {
    const beats = Array.from(track.querySelectorAll<HTMLElement>('[data-beat]'));
    const rails = Array.from(track.querySelectorAll<HTMLElement>('[data-rail]'));

    const wide = window.matchMedia('(min-width: 64rem)');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    let ticking = false;

    const render = () => {
      ticking = false;
      if (!track.classList.contains('is-scrolly')) return;

      const rect = track.getBoundingClientRect();
      const distance = track.offsetHeight - window.innerHeight;
      /* 0 when the track's top reaches the viewport top, 1 at its bottom. */
      const progress = distance > 0
        ? Math.min(1, Math.max(0, -rect.top / distance))
        : 0;

      const exact = progress * beats.length;
      const active = Math.min(beats.length - 1, Math.floor(exact));

      beats.forEach((beat, i) => {
        beat.classList.toggle('is-active', i === active);
        beat.classList.toggle('is-past', i < active);
        beat.setAttribute('aria-hidden', String(i !== active));
      });

      rails.forEach((rail, i) => {
        /* Each bar fills across its own beat, so the rail reads as progress
           through the story rather than four on/off lights. */
        const fill = Math.min(1, Math.max(0, exact - i));
        rail.style.setProperty('--fill', String(fill));
        rail.classList.toggle('is-active', i === active);
      });
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };

    const apply = () => {
      const enable = wide.matches && !still.matches;

      if (enable) {
        track.style.setProperty('--track-height', `${beats.length * 90}vh`);
        track.classList.add('is-scrolly');
        window.addEventListener('scroll', onScroll, { passive: true });
        render();
      } else {
        track.classList.remove('is-scrolly');
        track.style.removeProperty('--track-height');
        window.removeEventListener('scroll', onScroll);
        /* Hand the plain list back exactly as it renders without JS. */
        beats.forEach((beat) => {
          beat.classList.remove('is-active', 'is-past');
          beat.removeAttribute('aria-hidden');
        });
      }
    };

    apply();
    wide.addEventListener('change', apply);
    still.addEventListener('change', apply);
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>
