---
import Icon from './Icon.astro';
import StackMark from './StackMark.astro';
import { profile } from '../data/site';

const links = [
  { label: 'Email', href: `mailto:${profile.email}`, icon: 'email' as const },
  { label: 'GitHub', href: profile.github, icon: 'github' as const },
  { label: 'LinkedIn', href: profile.linkedin, icon: 'linkedin' as const },
  { label: 'CV', href: profile.resumeUrl, icon: 'document' as const },
];
---

<section id="top" class="section-pad flex min-h-[78svh] flex-col justify-center">
  <div class="shell">
    <div class="rail">
      <p class="label label--ticked label--rail lg:pt-3">{profile.role}</p>

      <div class="min-w-0">
        <div class="grid items-center gap-10 sm:grid-cols-[1fr_auto] sm:gap-12">
          <div class="min-w-0">
            <h1 class="text-hero" data-reveal>{profile.name}</h1>

            <p class="text-lede mt-8 max-w-lg text-ink-soft" data-reveal>
              {profile.intro}
            </p>
          </div>

          <div class="hidden sm:block" data-reveal>
            <StackMark />
          </div>
        </div>

        <div
          class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-rule pt-6"
          data-reveal
        >
          <p class="label flex items-center gap-2.5">
            <span class="dot-live inline-block h-1.5 w-1.5 rounded-full bg-signal"></span>
            Available for remote work
          </p>

          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link inline-flex items-center gap-1.5 font-mono text-sm"
                  {...link.href.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {}}
                  {...link.label === 'CV' ? { download: true } : {}}
                >
                  <Icon name={link.icon} />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
