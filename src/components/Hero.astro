---
import Icon from './Icon.astro';
import StackMark from './StackMark.astro';
import { profile } from '../data/site';

const links = [
  { label: 'Email', href: `mailto:${profile.email}`, icon: 'email' as const },
  { label: 'GitHub', href: profile.github, icon: 'github' as const },
  { label: 'LinkedIn', href: profile.linkedin, icon: 'linkedin' as const },
  { label: 'CV', href: profile.resumeUrl, icon: 'document' as const },
];
---

<section
  id="top"
  class="section-pad flex min-h-[68svh] flex-col justify-center sm:min-h-[78svh]"
>
  <div class="shell">
    <div class="rail">
      <p class="label label--ticked label--rail lg:pt-3">{profile.role}</p>

      <div class="min-w-0">
        {/*
          Named grid areas rather than two layouts, so the mark exists once in
          the DOM and simply lands in a different place.

          Narrow: the name takes a full row of its own — it needs the width —
          and the intro then shares the next row with the mark. Putting the
          mark on its own row left a large empty space to its left.

          Wide: the mark moves into a column of its own spanning both rows, so
          it sits beside the name and intro together.
        */}
        <div class="hero-grid">
          <h1 class="hero-grid__name text-hero" data-reveal>{profile.name}</h1>

          <p class="hero-grid__intro text-lede max-w-lg text-ink-soft" data-reveal>
            {profile.intro}
          </p>

          <div class="hero-grid__mark" data-reveal>
            <StackMark />
          </div>
        </div>

        <div
          class="mt-8 flex flex-col gap-4 border-t border-rule pt-6 sm:mt-10 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-6 sm:gap-y-3"
          data-reveal
        >
          <p class="label flex items-center gap-2.5">
            <span class="dot-live inline-block h-1.5 w-1.5 rounded-full bg-signal"></span>
            Available for remote work
          </p>

          <ul class="flex flex-wrap items-center gap-x-6 gap-y-3 sm:gap-x-5 sm:gap-y-2">
            {links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="link inline-flex items-center gap-1.5 font-mono text-sm"
                  {...link.href.startsWith('http')
                    ? { target: '_blank', rel: 'noopener noreferrer' }
                    : {}}
                >
                  <Icon name={link.icon} />
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    display: grid;
    grid-template-areas:
      'name name'
      'intro mark';
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: clamp(1rem, 4vw, 2rem);
    row-gap: 1.5rem;
  }

  .hero-grid__name {
    grid-area: name;
  }
  .hero-grid__intro {
    grid-area: intro;
  }
  .hero-grid__mark {
    grid-area: mark;
    /* Sized against the column it shares, so it never crowds the sentence. */
    width: clamp(4.5rem, 26vw, 8rem);
  }

  @media (min-width: 40rem) {
    .hero-grid {
      grid-template-areas:
        'name mark'
        'intro mark';
      column-gap: 3rem;
      row-gap: 2rem;
    }

    .hero-grid__mark {
      width: clamp(8rem, 20vw, 15rem);
      justify-self: end;
    }
  }
</style>
