---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { contributions } from '../data/site';
---

<Section id="open-source" label="Open Source">
  {/*
    One entry, deliberately. This section is only worth having if every line
    survives being clicked — a merged pull request in a repository someone else
    owns. Anything softer than that belongs in Side Projects.
  */}
  <ul class="divide-y divide-rule">
    {contributions.map((item) => (
      <li class="row py-6 first:pt-0 last:pb-0" data-reveal>
        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <a
            href={item.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="link inline-flex items-center gap-2 font-mono text-base"
          >
            <Icon name="github" class="h-4 w-4" />
            {item.repo}
          </a>
          <span class="font-mono text-xs text-ink-faint">
            ★ {item.stars}
          </span>
          <span class="ml-auto font-mono text-xs text-ink-faint">
            {item.merged}
          </span>
        </div>

        <p class="mt-3 text-ink">{item.title}</p>
        <p class="mt-2 max-w-2xl text-sm text-ink-muted">{item.detail}</p>

        <a
          href={item.prUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="link mt-4 inline-block font-mono text-sm"
        >
          View the pull request ↗
        </a>
      </li>
    ))}
  </ul>
</Section>
