---
/**
 * A ground scene along the bottom of the page: two shrubs, a tree, a cat house
 * on the right, and a cat that paces between them.
 *
 * The cat walks to the house, stops at the door, hops, then turns and heads
 * back — so the traversal has a destination rather than bouncing off an
 * invisible edge. It also stops and looks at you whenever the pointer comes
 * near, and dozes off if left alone.
 *
 * Everything is a filled silhouette in `currentColor` or `var(--paper)`, so it
 * inverts with the theme and is transparent by construction. Scenery sits at a
 * low opacity and behind the content layer: it should register at the edge of
 * vision while reading, never compete with the page.
 *
 * Motion is driven in JavaScript, not CSS keyframes, because the legs have to
 * stay in step with the distance actually covered each frame — a fixed
 * keyframe duration is what makes a walking sprite look like it is skating.
 *
 * Disabled under reduced-motion. aria-hidden and click-through throughout.
 */
---

<div
  id="scene"
  aria-hidden="true"
  class="pointer-events-none fixed inset-x-0 bottom-0 z-30 hidden h-0 text-ink-soft"
>
  <!--
    Scenery. Silhouettes with detail punched out in the page colour rather than
    drawn as extra strokes — that keeps every element a single flat shape, so
    it stays readable at 40px and inverts cleanly with the theme.
  -->

  <!-- Bush, left. Scalloped rather than circular: overlapping circles read as
       overlapping circles, a scalloped outline reads as foliage. -->
  <svg
    class="absolute bottom-0 left-[7%] h-[clamp(2rem,4.5vw,3.75rem)] w-auto opacity-[0.26]"
    viewBox="0 0 56 44"
    fill="currentColor"
    aria-hidden="true"
  >
    <ellipse cx="26" cy="42.5" rx="23" ry="2" opacity="0.4" />
    <path d="M6 42Q0 34 6 28Q4 19 13 17Q18 9 27 13Q37 10 41 19Q50 23 46 32Q49 40 40 42Z" />
    <g fill="var(--paper)" opacity="0.28">
      <path d="M18 24q3 4 0 8" />
      <path d="M30 21q3 5 0 10" />
    </g>
  </svg>

  <!-- Tree. Tapered trunk with a fork, and a scalloped canopy. -->
  <svg
    class="absolute bottom-0 left-[33%] h-[clamp(4rem,9vw,7.5rem)] w-auto opacity-[0.2]"
    viewBox="0 0 66 96"
    fill="currentColor"
    aria-hidden="true"
  >
    <ellipse cx="31" cy="94" rx="17" ry="2.2" opacity="0.35" />
    <path d="M30 94Q29.5 74 28 60L25 52h4l2 6q1-5 6-9l2 2q-6 5-6 12 1 14 1 31Z" />
    <path d="M12 52Q2 44 9 34Q6 20 19 17Q26 5 39 11Q54 8 58 22Q68 30 60 42Q63 52 50 55Q33 62 22 55Q13 57 12 52Z" />
    <g fill="var(--paper)" opacity="0.22">
      <path d="M24 28q4 6 0 12" />
      <path d="M40 24q4 7 0 14" />
      <path d="M50 34q3 5 0 10" />
    </g>
  </svg>

  <!-- Small shrub, mid-right. -->
  <svg
    class="absolute bottom-0 left-[60%] h-[clamp(1.6rem,3.4vw,2.75rem)] w-auto opacity-[0.24]"
    viewBox="0 0 44 34"
    fill="currentColor"
    aria-hidden="true"
  >
    <ellipse cx="22" cy="32.5" rx="19" ry="1.8" opacity="0.4" />
    <path d="M5 32Q0 25 5 20Q4 12 12 11Q17 4 25 8Q34 6 36 14Q43 18 39 25Q41 32 33 32Z" />
    <path d="M16 17q3 4 0 8" fill="none" stroke="var(--paper)" stroke-width="1.4" opacity="0.28" />
  </svg>

  <!-- The destination. Its measured position is what bounds the cat's walk. -->
  <svg
    id="cathouse"
    class="absolute bottom-0 right-[5%] h-[clamp(3.5rem,7.5vw,6.5rem)] w-auto opacity-[0.58]"
    viewBox="0 0 96 82"
    fill="none"
    aria-hidden="true"
  >
    <ellipse cx="48" cy="81" rx="44" ry="2.4" opacity="0.35" />

    <!-- Roof with an eave overhang either side, plus a ridge cap. -->
    <path d="M2 36 48 4l46 32H82L48 12 14 36Z" fill="currentColor" />
    <path d="M14 34 48 10l34 24v6H14Z" fill="currentColor" />
    <rect x="44" y="2" width="8" height="7" rx="2" fill="currentColor" />

    <!-- Shingle courses, punched out of the roof. -->
    <g stroke="var(--paper)" stroke-width="1.2" opacity="0.3">
      <path d="M22 30h52" />
      <path d="M28 24h40" />
      <path d="M34 18h28" />
    </g>

    <!-- Walls, with a plinth so it sits on the ground rather than floating. -->
    <rect x="14" y="39" width="68" height="38" rx="3" fill="currentColor" />
    <rect x="9" y="75" width="78" height="6" rx="2" fill="currentColor" />

    <!-- Plank seams. -->
    <g stroke="var(--paper)" stroke-width="1" opacity="0.22">
      <path d="M22 41v34" />
      <path d="M74 41v34" />
    </g>

    <!-- Arched doorway with a threshold step. -->
    <path d="M33 77V57a15 15 0 0 1 30 0v20Z" fill="var(--paper)" />
    <rect x="31" y="74" width="34" height="4" rx="2" fill="currentColor" opacity="0.55" />

    <!-- Name plate over the door: a paw, four toes and a pad. -->
    <g fill="var(--paper)" opacity="0.8">
      <ellipse cx="48" cy="31" rx="3.1" ry="2.6" />
      <circle cx="43.6" cy="26.6" r="1.3" />
      <circle cx="46.6" cy="24.8" r="1.3" />
      <circle cx="49.9" cy="24.8" r="1.3" />
      <circle cx="52.8" cy="26.6" r="1.3" />
    </g>
  </svg>

  <!-- Food bowl beside the house, because an empty doorstep looks unlived-in. -->
  <svg
    id="bowl"
    class="absolute bottom-0 right-[calc(5%+clamp(4.5rem,9vw,8rem))] h-[clamp(1rem,2vw,1.6rem)] w-auto opacity-[0.5]"
    viewBox="0 0 32 20"
    fill="currentColor"
    aria-hidden="true"
  >
    <ellipse cx="16" cy="18.5" rx="14" ry="1.6" opacity="0.4" />
    <path d="M4 7h24l-3 9a2 2 0 0 1-2 1.5H9A2 2 0 0 1 7 16Z" />
    <ellipse cx="16" cy="7" rx="12" ry="3.2" />
    <ellipse cx="16" cy="7" rx="8.2" ry="2" fill="var(--paper)" opacity="0.55" />
    <!-- Ripple, so it reads as water rather than an empty dish. -->
    <ellipse id="ripple" cx="16" cy="7" rx="3.4" ry="0.9" fill="none" stroke="currentColor" stroke-width="0.7" opacity="0.45" />
  </svg>

  <!-- The cat. -->
  <div id="companion" class="absolute bottom-0 left-0 will-change-transform">
    <svg
      viewBox="0 0 64 44"
      fill="none"
      aria-hidden="true"
      style="overflow: visible"
      class="h-auto w-[clamp(3rem,5.2vw,4.75rem)]"
    >
      <ellipse id="shadow" cx="32" cy="40.5" rx="17" ry="2" fill="currentColor" opacity="0.18" />

      <!-- Tapered tail as a filled curl. A stroke cannot taper, and a
           constant-width tail is most of what made the old one read as a
           diagram rather than an animal. -->
      <path
        id="tail"
        d="M16 22C7 22 3.5 12.5 8.5 7.5C10 6 12.5 7 11.8 9.2C9 13.5 10.5 19 16.5 19Z"
        fill="currentColor"
      />

      <g stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <line id="leg-bl" x1="20" y1="26" x2="20" y2="38" />
        <line id="leg-br" x1="26" y1="26" x2="26" y2="38" />
      </g>

      <!-- Body: back curve into the shoulder, chest, belly, rounded haunch.
           Drawn as one path so the silhouette has a spine. -->
      <path
        d="M15 21C15 14.5 24 12.5 33 13C40 13.4 45 16 47 20C48.5 23 47 28.5 43 29.5L21 29.5C15.5 29.5 15 25 15 21Z"
        fill="currentColor"
      />

      <g stroke="currentColor" stroke-width="5" stroke-linecap="round">
        <line id="leg-fl" x1="39" y1="26" x2="39" y2="38" />
        <line id="leg-fr" x1="45" y1="26" x2="45" y2="38" />
      </g>

      <!-- Tabby markings, punched out at low opacity. -->
      <g stroke="var(--paper)" stroke-width="1.6" stroke-linecap="round" opacity="0.3">
        <path d="M23 15.5q1.6 2.6 0 5" />
        <path d="M29 14.6q1.8 2.9 0 5.6" />
        <path d="M35 14.8q1.8 2.9 0 5.6" />
      </g>

      <g id="head">
        <!-- Ears before the skull so their bases are covered by it. -->
        <path d="M45.5 7 42.8 0.5 51 4Z" fill="currentColor" />
        <path d="M58.5 7 61.2 0.5 53 4Z" fill="currentColor" />
        <path d="M46.6 6.2 45.3 2.9 49.4 4.8Z" fill="var(--paper)" opacity="0.45" />
        <path d="M57.4 6.2 58.7 2.9 54.6 4.8Z" fill="var(--paper)" opacity="0.45" />

        <!-- Head is slightly wider than tall, with a soft jaw. -->
        <path
          d="M52 3.6C57 3.6 60.6 7.1 60.6 11.6C60.6 15.2 58.6 18 55.6 19.2C54.1 19.8 49.9 19.8 48.4 19.2C45.4 18 43.4 15.2 43.4 11.6C43.4 7.1 47 3.6 52 3.6Z"
          fill="currentColor"
        />

        <g stroke="var(--paper)" stroke-width="0.85" stroke-linecap="round" opacity="0.5">
          <path d="M54 15.6 61.5 14.2" />
          <path d="M54 16.8 61 18.2" />
        </g>

        <g id="eyes">
          <ellipse cx="48.6" cy="11.4" rx="2.4" ry="2.9" fill="var(--paper)" />
          <ellipse cx="55.4" cy="11.4" rx="2.4" ry="2.9" fill="var(--paper)" />
          <g id="pupils">
            <ellipse cx="48.6" cy="11.4" rx="1.05" ry="1.6" fill="currentColor" />
            <ellipse cx="55.4" cy="11.4" rx="1.05" ry="1.6" fill="currentColor" />
          </g>
        </g>

        <g id="eyes-shut" style="display:none" stroke="var(--paper)" stroke-width="1.3" stroke-linecap="round">
          <path d="M46.6 11.4q2 1.9 4 0" />
          <path d="M53.4 11.4q2 1.9 4 0" />
        </g>

        <!-- Muzzle: nose triangle over a small mouth. -->
        <path d="M52 14.6 50.7 13.4h2.6Z" fill="var(--paper)" opacity="0.75" />
        <path d="M52 14.6v1.1" stroke="var(--paper)" stroke-width="0.85" stroke-linecap="round" opacity="0.55" />
      </g>

      <g id="zzz" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.4" style="display:none">
        <path d="M55.5 4h3.4L55.5 7.4h3.4" opacity="0.8" />
        <path d="M60.3 0.4h2.2l-2.2 2.2h2.2" opacity="0.45" />
      </g>
    </svg>
  </div>
</div>

<script>
  const scene = document.getElementById('scene');
  const el = document.getElementById('companion');
  const house = document.getElementById('cathouse');
  const bowl = document.getElementById('bowl');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (scene && el && !reduced) {
    const legs = ['leg-bl', 'leg-br', 'leg-fl', 'leg-fr'].map((id) =>
      document.getElementById(id),
    );
    const tail = document.getElementById('tail');
    const head = document.getElementById('head');
    const pupils = document.getElementById('pupils');
    const eyes = document.getElementById('eyes');
    const eyesShut = document.getElementById('eyes-shut');
    const zzz = document.getElementById('zzz');
    const shadow = document.getElementById('shadow');
    const ripple = document.getElementById('ripple');

    /* Diagonal pairs swing together, which is how a cat actually walks. */
    const PHASE = [0, Math.PI, Math.PI, 0];
    const PIVOTS = ['20px 26px', '26px 26px', '39px 26px', '45px 26px'];
    legs.forEach((leg, i) => {
      if (leg) leg.style.transformOrigin = PIVOTS[i];
    });
    if (tail) tail.style.transformOrigin = '16px 21px';
    if (head) head.style.transformOrigin = '50px 20px';

    const SPEED = 34;
    const SLEEP_AFTER = 6;
    const NEAR = 120;
    const JUMP_MS = 620;
    const JUMP_HEIGHT = 26;
    /* A beat at the door before and after the hop, so arrival reads as a
       decision rather than a bounce. */
    const PAUSE_MS = 420;
    const DRINK_MS = 2800;

    type Mode = 'walk' | 'drink' | 'arrive' | 'jump' | 'leave';

    let mode: Mode = 'walk';
    let modeStart = performance.now();
    let x = -20;
    let direction = 1;
    let phase = 0;
    let idle = 0;
    let pointerX = -9999;
    let pointerY = -9999;
    let last = performance.now();
    /* One drink per outbound trip, reset when the cat turns around at the far
       end — otherwise it would re-trigger on every frame at the bowl. */
    let hasDrunk = false;

    document.addEventListener(
      'pointermove',
      (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
      },
      { passive: true },
    );

    /** Where the cat should stop: just short of the doorway. */
    const doorstep = (catWidth: number) => {
      if (!house) return window.innerWidth - catWidth;
      const box = house.getBoundingClientRect();
      return Math.max(0, box.left + box.width * 0.28 - catWidth);
    };

    /**
     * Where the cat stands to reach the bowl. Its head sits near the right of
     * the sprite, so the body must stop short for the muzzle to land in the
     * bowl rather than past it.
     */
    const bowlside = (catWidth: number) => {
      if (!bowl) return null;
      const box = bowl.getBoundingClientRect();
      return box.left + box.width / 2 - catWidth * 0.8;
    };

    const setMode = (next: Mode, now: number) => {
      mode = next;
      modeStart = now;
    };

    const frame = (now: number) => {
      /* Clamped so returning from a background tab cannot teleport the cat
         across the screen in one enormous step. */
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      const box = el.getBoundingClientRect();
      const cx = box.left + box.width / 2;
      const cy = box.top + box.height / 2;
      const alert = Math.hypot(pointerX - cx, pointerY - cy) < NEAR;

      const rightLimit = doorstep(box.width);
      const leftLimit = -box.width * 0.25;

      let lift = 0;
      let walking = false;

      if (alert && mode === 'walk') {
        /* Stop and pay attention. */
        idle += dt;
      } else {
        switch (mode) {
          case 'walk': {
            walking = !document.hidden;
            if (walking) {
              idle = 0;
              const step = SPEED * dt;
              x += direction * step;
              /* Cadence from distance covered, never from elapsed time. */
              phase += (step / 4.5) * Math.PI;

              const drinkAt = bowlside(box.width);
              if (direction === 1 && !hasDrunk && drinkAt !== null && x >= drinkAt) {
                x = drinkAt;
                hasDrunk = true;
                setMode('drink', now);
              } else if (direction === 1 && x >= rightLimit) {
                x = rightLimit;
                setMode('arrive', now);
              } else if (direction === -1 && x <= leftLimit) {
                x = leftLimit;
                direction = 1;
                hasDrunk = false;
              }
            }
            break;
          }

          case 'drink': {
            if (now - modeStart > DRINK_MS) setMode('walk', now);
            break;
          }

          case 'arrive': {
            if (now - modeStart > PAUSE_MS) setMode('jump', now);
            break;
          }

          case 'jump': {
            const t = (now - modeStart) / JUMP_MS;
            if (t >= 1) {
              setMode('leave', now);
            } else {
              /* A single arc: up and back down over the whole duration. */
              lift = Math.sin(t * Math.PI) * JUMP_HEIGHT;
            }
            break;
          }

          case 'leave': {
            if (now - modeStart > PAUSE_MS) {
              direction = -1;
              setMode('walk', now);
            }
            break;
          }
        }
      }

      if (!walking) {
        idle += dt;
        phase += dt * 0.7;
      }

      const asleep = idle > SLEEP_AFTER && !alert && mode === 'walk';
      const airborne = mode === 'jump';
      const drinking = mode === 'drink';
      /* Lapping envelope: eased in and out so the head is not snapping into
         and out of the bowl. */
      const drinkT = drinking ? (now - modeStart) / DRINK_MS : 0;
      const lap = drinking ? Math.min(1, Math.min(drinkT, 1 - drinkT) * 6) : 0;

      legs.forEach((leg, i) => {
        if (!leg) return;
        if (airborne) {
          /* Tucked underneath mid-hop. */
          leg.style.transform = `rotate(${i < 2 ? 26 : -26}deg)`;
        } else {
          leg.style.transform = walking
            ? `rotate(${Math.sin(phase + PHASE[i]) * 24}deg)`
            : 'rotate(0deg)';
        }
      });

      if (tail) {
        const sway = drinking
          ? Math.sin(now / 380) * 5
          : airborne
          ? -22
          : walking
            ? Math.sin(phase * 0.5) * 14
            : Math.sin(phase * 1.6) * (asleep ? 3 : 10);
        tail.style.transform = `rotate(${sway}deg)`;
      }

      /* Head turn is multiplied by direction so the tilt goes the right way
         once the whole sprite has been mirrored. */
      if (head && drinking) {
        /* Muzzle down into the bowl, with the lapping bob on top. */
        const bob = Math.sin(now / 90) * 1.2 * lap;
        head.style.transform =
          `translate(${2.5 * lap * direction}px, ${5.5 * lap + bob}px) rotate(${30 * lap * direction}deg)`;
      } else if (head) {
        const bob = walking ? Math.sin(phase) * 1.4 : 0;
        const tilt = airborne
          ? -8 * direction
          : alert
            ? Math.max(-13, Math.min(13, ((pointerY - cy) / 90) * 13)) * direction
            : asleep
              ? 9 * direction
              : 0;
        head.style.transform = `translateY(${bob}px) rotate(${tilt}deg)`;
      }

      if (pupils) {
        const px = Math.max(-1.2, Math.min(1.2, (pointerX - cx) / 170)) * direction;
        const py = Math.max(-1, Math.min(1, (pointerY - cy) / 170));
        pupils.style.transform = `translate(${px}px, ${py}px)`;
      }

      /* The shadow shrinks and lightens as the cat leaves the ground, which
         is what actually sells the hop as a hop. */
      if (shadow) {
        const lifted = lift / JUMP_HEIGHT;
        shadow.style.transformOrigin = '32px 40.5px';
        shadow.style.transform = `scale(${1 - lifted * 0.35})`;
        shadow.style.opacity = String(0.18 - lifted * 0.1);
      }

      /* The water answers back while the cat drinks. */
      if (ripple) {
        ripple.style.transformOrigin = '16px 7px';
        ripple.style.transform = drinking
          ? `scale(${1 + Math.abs(Math.sin(now / 260)) * 0.9})`
          : 'scale(1)';
        ripple.style.opacity = drinking
          ? String(0.5 - Math.abs(Math.sin(now / 260)) * 0.35)
          : '0.18';
      }

      const shut =
        asleep ||
        /* Cats half-close their eyes while drinking. */
        (drinking && lap > 0.6) ||
        (!walking && !airborne && !drinking && Math.sin(now / 1500) > 0.987);
      if (eyes) eyes.style.display = shut ? 'none' : '';
      if (eyesShut) eyesShut.style.display = shut ? '' : 'none';
      if (zzz) zzz.style.display = asleep ? '' : 'none';

      el.style.transform = `translate3d(${x}px, ${-lift}px, 0) scaleX(${direction})`;
      requestAnimationFrame(frame);
    };

    scene.classList.remove('hidden');
    requestAnimationFrame(frame);
  }
</script>
