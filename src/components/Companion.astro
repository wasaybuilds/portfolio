---
/**
 * A cat that walks along the bottom of the page and watches the cursor.
 *
 * Drawn here rather than loaded from a .riv, after trying four community
 * files. Every one of them carried problems that cannot be fixed from code:
 * an opaque artboard background baked into the binary, no walk cycle on the
 * rigs that tracked the cursor, no cursor tracking on the rig that walked, and
 * 31KB–2.5MB of asset plus a 173KB runtime for a decorative detail.
 *
 * This has none of those. It is transparent by construction, draws in the
 * page's own ink colour so it inverts with the theme, weighs about 3KB, and
 * needs no dependency.
 *
 * The motion is driven in JavaScript rather than CSS keyframes because the
 * legs have to stay in step with the distance actually covered each frame. A
 * fixed keyframe duration is what makes a walking sprite look like it is
 * skating.
 *
 * Behaviour: paces the bottom of the viewport, turns its head toward the
 * pointer, stops and sits when you come near, and dozes off if left alone.
 * Disabled under reduced-motion. aria-hidden and click-through throughout —
 * it is decoration and must never intercept a click or reach a screen reader.
 */
---

<div
  id="companion"
  aria-hidden="true"
  class="pointer-events-none fixed bottom-0 left-0 z-40 hidden opacity-0 transition-opacity duration-700 will-change-transform"
>
  <svg
    width="52"
    height="40"
    viewBox="0 0 52 40"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="text-ink-soft"
  >
    <!-- Back legs first so the body overlaps them, which reads as depth. -->
    <line id="leg-bl" x1="15" y1="26" x2="15" y2="33" />
    <line id="leg-br" x1="20" y1="26" x2="20" y2="33" />
    <line id="leg-fl" x1="31" y1="26" x2="31" y2="33" />
    <line id="leg-fr" x1="36" y1="26" x2="36" y2="33" />

    <path id="tail" d="M13 25c-6 0-7.5-4.5-5-7.5" />

    <path d="M13 25h21a4.5 4.5 0 0 0 4.5-4.5V19" />
    <path d="M13 25v-5" />

    <g id="head">
      <circle cx="39" cy="13" r="7" />
      <path d="M34 7.5 32 2l5.5 2.6" />
      <path d="M44 7.5 46 2l-5.5 2.6" />

      <!-- Pupils are moved by script to follow the pointer. -->
      <g id="eyes">
        <circle id="pupil-l" cx="36.6" cy="12.2" r="1.05" fill="currentColor" stroke="none" />
        <circle id="pupil-r" cx="41.4" cy="12.2" r="1.05" fill="currentColor" stroke="none" />
      </g>
      <g id="eyes-shut" style="display:none">
        <path d="M35.4 12.4q1.2 1.1 2.4 0" />
        <path d="M40.2 12.4q1.2 1.1 2.4 0" />
      </g>

      <path d="M38.2 15.6h1.6" />
    </g>

    <g id="zzz" style="display:none">
      <path d="M44 5h3.2l-3.2 3.2h3.2" opacity="0.85" />
      <path d="M48.8 1h2.2l-2.2 2.2h2.2" opacity="0.5" />
    </g>
  </svg>
</div>

<script>
  const el = document.getElementById('companion');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (el && !reduced) {
    const legs = ['leg-bl', 'leg-br', 'leg-fl', 'leg-fr'].map((id) =>
      document.getElementById(id),
    );
    const tail = document.getElementById('tail');
    const head = document.getElementById('head');
    const eyes = document.getElementById('eyes');
    const eyesShut = document.getElementById('eyes-shut');
    const zzz = document.getElementById('zzz');

    /* Diagonal pairs swing together, which is how a cat actually walks. */
    const PHASE = [0, Math.PI, Math.PI, 0];
    const PIVOTS = ['15px 26px', '20px 26px', '31px 26px', '36px 26px'];
    legs.forEach((leg, i) => {
      if (leg) leg.style.transformOrigin = PIVOTS[i];
    });
    if (tail) tail.style.transformOrigin = '13px 25px';
    if (head) head.style.transformOrigin = '39px 16px';

    const SPEED = 34;
    const SLEEP_AFTER = 6;
    const NEAR = 110;

    let x = -30;
    let direction = 1;
    let phase = 0;
    let idle = 0;
    let pointerX = -9999;
    let pointerY = -9999;
    let last = performance.now();

    document.addEventListener(
      'pointermove',
      (event) => {
        pointerX = event.clientX;
        pointerY = event.clientY;
        if (el.style.opacity !== '0.85') el.style.opacity = '0.85';
      },
      { passive: true },
    );

    const frame = (now: number) => {
      /* Clamped so returning from a background tab cannot teleport the cat
         across the screen in a single enormous step. */
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      const box = el.getBoundingClientRect();
      const cx = box.left + box.width / 2;
      const cy = box.top + box.height / 2;
      const distance = Math.hypot(pointerX - cx, pointerY - cy);

      /* Stop and pay attention when the pointer comes close. */
      const alert = distance < NEAR;
      const walking = !alert && !document.hidden;

      if (walking) {
        idle = 0;
        const step = SPEED * dt;
        x += direction * step;
        phase += (step / 4.5) * Math.PI;

        const limit = window.innerWidth - box.width;
        if (x >= limit) {
          x = limit;
          direction = -1;
        } else if (x <= -box.width * 0.3) {
          x = -box.width * 0.3;
          direction = 1;
        }
      } else {
        idle += dt;
        phase += dt * 0.7;
      }

      const asleep = idle > SLEEP_AFTER && !alert;

      legs.forEach((leg, i) => {
        if (!leg) return;
        const swing = walking ? Math.sin(phase + PHASE[i]) * 27 : 0;
        leg.style.transform = `rotate(${swing}deg)`;
      });

      if (tail) {
        const sway = walking
          ? Math.sin(phase * 0.5) * 13
          : Math.sin(phase * 1.6) * (asleep ? 3 : 9);
        tail.style.transform = `rotate(${sway}deg)`;
      }

      /* Head turns toward the pointer. Divided by the mirror so the tilt goes
         the right way when the cat is facing left. */
      if (head) {
        const dip = walking ? Math.sin(phase) * 1.5 : 0;
        const tilt = alert
          ? Math.max(-14, Math.min(14, ((pointerY - cy) / 90) * 14)) * direction
          : asleep
            ? 8 * direction
            : 0;
        head.style.transform = `translateY(${dip}px) rotate(${tilt}deg)`;
      }

      /* Pupils track the pointer within the eye, which sells the attention
         far more cheaply than rotating the whole head further. */
      if (eyes) {
        const px = Math.max(-1.3, Math.min(1.3, (pointerX - cx) / 160)) * direction;
        const py = Math.max(-1, Math.min(1, (pointerY - cy) / 160));
        eyes.style.transform = `translate(${px}px, ${py}px)`;
      }

      const blinking = !walking && Math.sin(now / 1500) > 0.987;
      const shut = asleep || blinking;
      if (eyes) eyes.style.display = shut ? 'none' : '';
      if (eyesShut) eyesShut.style.display = shut ? '' : 'none';
      if (zzz) zzz.style.display = asleep ? '' : 'none';

      el.style.transform = `translate3d(${x}px, 0, 0) scaleX(${direction})`;
      requestAnimationFrame(frame);
    };

    el.classList.remove('hidden');
    el.style.opacity = '0.85';
    requestAnimationFrame(frame);
  }
</script>
